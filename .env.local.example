# Copia este archivo a .env.local (ignorado por git) — lo rellena automáticamente
# "npx convex dev" la primera vez que lo ejecutes y hagas login.
NEXT_PUBLIC_CONVEX_URL=

# PRO-63 — login con Google. Solo el client_id (sin prefijo NEXT_PUBLIC_:
# lo lee un Route Handler server-only, app/api/auth/google/start/route.ts).
# El client_secret NUNCA va aquí — vive solo como variable de entorno de
# Convex (`npx convex env set GOOGLE_CLIENT_SECRET ...`), ver README.md.
GOOGLE_CLIENT_ID=

# PRO-65 — URL pública canónica de la app, usada por las Route Handlers de
# Google en vez de confiar en request.url (roto en Railway: ver README.md).
APP_URL=http://localhost:3000
